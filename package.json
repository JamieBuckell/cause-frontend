{
  "name": "cause-foundation-management-application",
  "version": "2.0.7",
  "description": "Cause Foundation Management Application",
  "author": "Jamie Buckell",
  "private": true,
  "scripts": {
    "build": "vue-cli-service build && npm run sentry:sourcemaps",
    "dev": "vue-cli-service serve --open",
    "lint": "vue-cli-service lint",
    "deploy": "aws s3 cp dist/ s3://causef.jamiebuckell.co.uk/ --profile jamiebuckell --recursive",
    "clear-cache": "aws cloudfront create-invalidation --profile jamiebuckell --distribution-id E3S4Z05K6XBLYL --paths /\\* /index.html /service-worker\\* /precache-manifest\\*",
    "clear-cache-bouchelle": "aws cloudfront create-invalidation --profile jamiebuckell --distribution-id E2G9Q9M0SNBI07 --paths /\\* /index.html /service-worker\\* /precache-manifest\\*",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org cause-foundation --project javascript-vue ./dist && sentry-cli sourcemaps upload --org cause-foundation --project javascript-vue ./dist"
  },
  "dependencies": {
    "@fullcalendar/core": "5.10.1",
    "@fullcalendar/daygrid": "5.10.1",
    "@fullcalendar/interaction": "5.10.1",
    "@fullcalendar/timegrid": "5.10.1",
    "@fullcalendar/vue": "5.10.1",
    "@sentry/cli": "^2.21.2",
    "@sentry/vue": "^7.73.0",
    "amazon-cognito-identity-js": "^5.2.8",
    "aws-sdk": "^2.1096.0",
    "axios": "^1.5.1",
    "bootstrap": "4.6.0",
    "chartist": "0.11.4",
    "cookie": "^0.5.0",
    "core-js": "3.21.1",
    "country-list": "^2.2.0",
    "crypto": "^1.0.1",
    "d3": "7.3.0",
    "datamaps": "0.5.9",
    "easy-pie-chart": "2.1.7",
    "element-ui": "2.15.6",
    "es6-promise": "4.2.8",
    "fuse.js": "6.5.3",
    "google-maps": "4.3.3",
    "js-cookie": "^2.2.1",
    "moment": "^2.29.4",
    "perfect-scrollbar": "1.5.5",
    "secure-ls": "^1.2.6",
    "sweetalert2": "11.4.4",
    "topojson": "3.0.2",
    "v-tooltip": "2.1.3",
    "vee-validate": "3.4.11",
    "vue": "^2.7.14",
    "vue-clickaway": "2.2.2",
    "vue-form-wizard": "0.8.4",
    "vue-jwt-decode": "^0.1.0",
    "vue-nav-tabs": "0.5.7",
    "vue-qrcode-reader": "^3.1.0",
    "vue-router": "3.5.2",
    "vue-social-sharing": "^3.0.9",
    "vue-uuid": "^3.0.0",
    "vue-wysiwyg": "^1.7.2",
    "vue2-google-maps": "0.10.7",
    "vue2-transitions": "0.3.0",
    "vuex": "^3.0.1",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.13",
    "@vue/cli-plugin-eslint": "4.5.13",
    "@vue/cli-service": "4.5.13",
    "babel-plugin-component": "1.1.1",
    "eslint": "7.32.0",
    "eslint-plugin-vue": "7.20.0",
    "sass": "1.49.9",
    "sass-loader": "10.2.1",
    "vue-template-compiler": "2.6.14"
  },
  "engines": {
    "node": ">= 4.0.0",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}